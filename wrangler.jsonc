// Cloudflare Worker som serverer HUB Prosjektrom som statiske filer.
// `wrangler deploy` kjører build-kommandoen først, som lager public/index.html fra index.html.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "sh scripts/build.sh"
  },
  "assets": {
    "directory": "./public"
  }
}
